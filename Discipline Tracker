  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Baloo+Telugu+2:wght@500;750;800&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Baloo Telugu 2', 'Poppins', sans-serif;
      background: linear-gradient(135deg, #e0f2fe 0%, #fef08a 50%, #fed7aa 100%);
