    @keyframes pop {
      0% { transform: scale(0); opacity: 0; }
      70% { transform: scale(1.2); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
  </style>
</head>
<body class="text-slate-800 flex flex-col items-center justify-between p-4 md:p-8">

  <header class="w-full max-w-4xl text-center mb-6">
    <div class="inline-block bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 px-8 py-3.5 rounded-3xl shadow-xl mb-4 border-4 border-yellow-300 transform hover:scale-105 transition-all">
      <span class="text-white font-extrabold text-base md:text-xl tracking-wide uppercase drop-shadow">
        <i class="fa-solid fa-award text-yellow-300 mr-2 animate-spin"></i> 
        Children's Garden E.M HIGH SCHOOL 
        <i class="fa-solid fa-award text-yellow-300 ml-2 animate-spin"></i>
      </span>
    </div>
    <div class="inline-block bg-white/90 backdrop-blur px-6 py-2 rounded-full shadow-md mb-2 border border-blue-200 block">
      <span class="text-blue-600 font-bold text-lg"><i class="fa-solid fa-shield-halved text-blue-500"></i> క్రమశిక్షణే విజయానికి సోపానం <i class="fa-solid fa-shield-halved text-blue-500"></i></span>
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-indigo-900 drop-shadow-sm">
      విద్యార్థుల క్రమశిక్షణ (Discipline Tracker) 🛡️️
    </h1>
    <p class="text-lg md:text-xl text-slate-700 mt-1">
      ప్రతిరోజూ ఈ మంచి సూత్రాలు పాటించి బెస్ట్ స్టూడెంట్ అవ్వండి!
    </p>
  </header>

  <main class="w-full max-w-4xl grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    
    <!-- Mascot Box -->
    <div class="bg-white/95 backdrop-blur rounded-3xl p-6 shadow-xl border-4 border-blue-300 flex flex-col items-center justify-center text-center relative overflow-hidden">
      <div class="absolute top-3 left-3 bg-blue-100 text-blue-800 font-bold px-3 py-1 rounded-full text-sm">
        Discipline Score: <span id="score-val">0</span> ⭐
      </div>
      <div class="w-32 h-32 bg-blue-50 rounded-full flex items-center justify-center text-6xl shadow-inner mt-4 mb-4 float-anim" id="mascot-avatar">
        👨‍🎓
      </div>
      <h2 id="mascot-speech" class="text-xl font-bold text-blue-900 mb-2">
        "క్రమశిక్షణతో చదువుదాం, విజయం సాధిద్దాం!"
      </h2>
      <p class="text-sm text-slate-500">కింద ఉన్న క్రమశిక్షణ నియమాలపై క్లిక్ చేసి పాయింట్లు పొందండి.</p>
    </div>

    <!-- Discipline Cards Container -->
    <div class="md:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
      
      <!-- Rule 1: School ki samayaaniki velladam -->
      <div onclick="completeRule('schooltime', this)" class="rule-card bg-white hover:bg-blue-50 transition-all cursor-pointer rounded-2xl p-5 shadow-lg border-2 border-blue-200 flex items-center gap-4 bounce-click">
        <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center text-3xl text-blue-600 flex-shrink-0">
          🏫
        </div>
        <div>
          <h3 class="font-bold text-lg text-slate-800">స్కూల్‌కి సమయానికి వెళ్లడం</h3>
          <p class="text-sm text-slate-500">ప్రతిరోజూ ప్రార్థన సమయానికి ముందే బడికి చేరుకోవడం.</p>
        </div>
        <div class="ml-auto text-2xl check-icon opacity-20">✅</div>
      </div>

      <!-- Rule 2: Prathiroju homework ni poorthi cheyyadam -->
      <div onclick="completeRule('homework', this)" class="rule-card bg-white hover:bg-emerald-50 transition-all cursor-pointer rounded-2xl p-5 shadow-lg border-2 border-emerald-200 flex items-center gap-4 bounce-click">
        <div class="w-14 h-14 bg-emerald-100 rounded-2xl flex items-center justify-center text-3xl text-emerald-600 flex-shrink-0">
          📝
        </div>
        <div>
          <h3 class="font-bold text-lg text-slate-800">హోమ్‌వర్క్ పూర్తి చేయడం</h3>
          <p class="text-sm text-slate-500">రోజు ఇచ్చిన హోమ్‌వర్క్‌ను శ్రద్ధగా పూర్తి చేసి తెవడం.</p>
        </div>
        <div class="ml-auto text-2xl check-icon opacity-20">✅</div>
      </div>

      <!-- Rule 3: Respecting Teachers & Elders -->
      <div onclick="completeRule('respect', this)" class="rule-card bg-white hover:bg-indigo-50 transition-all cursor-pointer rounded-2xl p-5 shadow-lg border-2 border-indigo-200 flex items-center gap-4 bounce-click">
        <div class="w-14 h-14 bg-indigo-100 rounded-2xl flex items-center justify-center text-3xl text-indigo-600 flex-shrink-0">
          🙏
        </div>
        <div>
          <h3 class="font-bold text-lg text-slate-800">పెద్దలను గౌరవించడం</h3>
          <p class="text-sm text-slate-500">ఉపాధ్యాయులకు, తల్లిదండ్రులకు నమస్కరించి గౌరవించడం.</p>
        </div>
        <div class="ml-auto text-2xl check-icon opacity-20">✅</div>
      </div>

      <!-- Rule 4: Uniform & Cleanliness -->
      <div onclick="completeRule('uniform', this)" class="rule-card bg-white hover:bg-amber-50 transition-all cursor-pointer rounded-2xl p-5 shadow-lg border-2 border-amber-200 flex items-center gap-4 bounce-click">
        <div class="w-14 h-14 bg-amber-100 rounded-2xl flex items-center justify-center text-3xl text-amber-600 flex-shrink-0">
          👕
        </div>
        <div>
          <h3 class="font-bold text-lg text-slate-800">శుభ్రమైన యూనిఫామ్</h3>
          <p class="text-sm text-slate-500">ఇస్త్రీ చేసిన బట్టలు, శుభ్రమైన బూట్లు వేసుకోవడం.</p>
        </div>
        <div class="ml-auto text-2xl check-icon opacity-20">✅</div>
      </div>

      <!-- Rule 5: Silence in Classroom -->
      <div onclick="completeRule('silence', this)" class="rule-card bg-white hover:bg-purple-50 transition-all cursor-pointer rounded-2xl p-5 shadow-lg border-2 border-purple-200 flex items-center gap-4 bounce-click">
        <div class="w-14 h-14 bg-purple-100 rounded-2xl flex items-center justify-center text-3xl text-purple-600 flex-shrink-0">
          🤫
        </div>
        <div>
          <h3 class="font-bold text-lg text-slate-800">తరగతిలో నిశ్శబ్దం</h3>
          <p class="text-sm text-slate-500">పాఠం చెప్పేటప్పుడు శ్రద్ధగా విని నిశ్శబ్దంగా ఉండడం.</p>
        </div>
        <div class="ml-auto text-2xl check-icon opacity-20">✅</div>
      </div>

      <!-- Rule 6: Organizing Books -->
      <div onclick="completeRule('books', this)" class="rule-card bg-white hover:bg-rose-50 transition-all cursor-pointer rounded-2xl p-5 shadow-lg border-2 border-rose-200 flex items-center gap-4 bounce-click">
        <div class="w-14 h-14 bg-rose-100 rounded-2xl flex items-center justify-center text-3xl text-rose-600 flex-shrink-0">
          📚
        </div>
        <div>
          <h3 class="font-bold text-lg text-slate-800">పుస్తకాల అమరిక</h3>
          <p class="text-sm text-slate-500">స్కూల్ బ్యాగ్‌లో బుక్స్ నీట్‌గా సర్దుకోవడం.</p>
        </div>
        <div class="ml-auto text-2xl check-icon opacity-20">✅</div>
      </div>

    </div>

  </main>

  <footer class="w-full max-w-4xl bg-white/90 backdrop-blur rounded-2xl p-4 shadow-lg border border-slate-200 text-center flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-slate-600 font-semibold text-sm">
      💡 చిట్కా: ప్రతిరోజూ క్రమశిక్షణ పాటించి ఉత్తమ విద్యార్థిగా పేరు తెచ్చుకోండి!
    </div>
    <button onclick="resetRules()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-6 py-2 rounded-xl shadow transition-all bounce-click">
      <i class="fa-solid fa-rotate-right mr-2"></i> మళ్ళీ మొదలుపెట్టు
    </button>
  </footer>

  <!-- Celebration Modal -->
  <div id="celebration-modal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-8 max-w-md w-full text-center shadow-2xl border-4 border-yellow-400 star-pop">
      <div class="text-6xl mb-4">🎖️🎉</div>
      <h2 class="text-3xl font-extrabold text-blue-900 mb-2">అద్భుతం!</h2>
      <p class="text-slate-600 mb-6">మీరు క్రమశిక్షణ నియమాలన్నీ పాటించి మోడల్ స్టూడెంట్‌గా నిలిచారు!</p>
      <button onclick="closeModal()" class="bg-gradient-to-r from-yellow-400 to-amber-500 text-slate-900 font-extrabold px-8 py-3 rounded-2xl shadow-lg hover:scale-105 transition-all">
        సూపర్! 🌟
      </button>
    </div>
  </div>

  <script>
    let score = 0;
    const completed = {
      schooltime: false,
      homework: false,
      respect: false,
      uniform: false,
      silence: false,
      books: false
    };

    const speeches = [
      "చాలా మంచి అలవాటు! ఇలాగే ఉండండి!",
      "క్రమశిక్షణే నిజమైన ఆభరణం!",
      "వెరీ గుడ్! మరో రూల్ పూర్తి చేయండి!",
      "స్కూల్‌కి గర్వకారణం మీరు!"
    ];

    function completeRule(id, element) {
      if (completed[id]) return;
      
      completed[id] = true;
      score += 15;
      document.getElementById('score-val').innerText = score;
      
      element.classList.remove('bg-white');
      element.classList.add('bg-blue-100', 'border-blue-500');
      element.querySelector('.check-icon').style.opacity = '1';
      
      const randomSpeech = speeches[Math.floor(Math.random() * speeches.length)];
      document.getElementById('mascot-speech').innerText = `"${randomSpeech}"`;
      document.getElementById('mascot-avatar').innerHTML = '⭐';
      
      setTimeout(() => {
        document.getElementById('mascot-avatar').innerHTML = '👨‍🎓';
      }, 1000);

      if (Object.values(completed).every(val => val === true)) {
        setTimeout(() => {
          document.getElementById('celebration-modal').style.display = 'flex';
        }, 500);
      }
    }

    function closeModal() {
      document.getElementById('celebration-modal').style.display = 'none';
    }

    function resetRules() {
      score = 0;
      document.getElementById('score-val').innerText = score;
      for (let key in completed) {
        completed[key] = false;
      }
      document.querySelectorAll('.rule-card').forEach(card => {
        card.className = "rule-card bg-white hover:bg-blue-50 transition-all cursor-pointer rounded-2xl p-5 shadow-lg border-2 border-blue-200 flex items-center gap-4 bounce-click";
        card.querySelector('.check-icon').style.opacity = '0.2';
      });
      document.getElementById('mascot-speech').innerText = `"మళ్ళీ మొదలుపెట్టాం! అన్ని పూర్తి చేద్దాం!"`;
    }
  </script>

</body>
</html>
